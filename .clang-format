# 기본 스타일 가이드로 Google 스타일을 사용합니다.
BasedOnStyle: Google

# --- 빈 줄(엔터) 유지 설정 ---
# 연속된 빈 줄을 최대 몇 개까지 허용할지 결정합니다. (100개면 사실상 무제한)
MaxEmptyLinesToKeep: 100
# 함수나 제어문 블록({)이 시작되는 지점에 빈 줄이 있을 경우 유지합니다.
KeepEmptyLinesAtTheStartOfBlocks: true

# --- 들여쓰기 및 탭 설정 ---
# 들여쓰기 너비를 4칸으로 설정합니다.
IndentWidth: 4
# 탭 문자의 너비를 4칸으로 설정합니다.
TabWidth: 4

# --- 기타 스타일 세부 조정 ---
# if (condition) return; 처럼 짧은 제어문을 한 줄로 쓰는 것을 허용합니다.
AllowShortIfStatementsOnASingleLine: true
# 함수나 제어문 이름과 괄호 ( 사이의 공백을 제거합니다. (예: if(...) 대신 if (...))
# Never로 설정하면 'if(' 와 같이 붙여서 쓰게 됩니다.
SpaceBeforeParens: Never
# SpaceBeforeParens: ControlStatements